rules_version = '2';

// O Firestore não é usado por este projeto: o conteúdo do portfólio vive no
// appbackend (https://v1.appbackend.io) e é servido pela Cloud Function, que
// fala com ele por HTTP; o cliente só usa o Firebase para Auth (login do admin).
//
// O `firebase init` escreveu aqui a regra de "modo de teste", que libera leitura
// e escrita para qualquer pessoa até 2026-12-17 — um banco vazio, mas aberto
// para qualquer um gravar. Negar tudo fecha essa janela: o Admin SDK das
// Functions ignora estas regras, então nada que funciona depende delas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
