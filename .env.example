# Firebase web configuration is public client configuration, not authorization.
# Never put service-account credentials, APPBACKEND_COLLECTION_ID, or other
# server-side secrets in VITE_* variables.
VITE_FIREBASE_API_KEY="AIzaSyCpmbNf2EHV2RkUjrcyIm7dqZBnk3RV-xY"
VITE_FIREBASE_AUTH_DOMAIN="portifolio-7b841.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="portifolio-7b841"
VITE_FIREBASE_STORAGE_BUCKET="portifolio-7b841.firebasestorage.app"
VITE_FIREBASE_APP_ID="1:583383590112:web:372870d5244d16473a5c85"

# Admin API base URL. Local Functions emulator (see firebase.json):
VITE_ADMIN_API_URL=http://127.0.0.1:5001/demo-project/us-central1/api
# Production example: https://us-central1-<project-id>.cloudfunctions.net/api

# Leave empty (or delete the line) for production builds: when set, the app
# signs in against the local Auth emulator instead of the real project.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# APPBACKEND_COLLECTION_ID is a server-side value: keep it in
# functions/.secret.local (emulator) and Secret Manager (deployed), never here.

